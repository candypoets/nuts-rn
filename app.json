{
  "expo": {
    "name": "Nuts",
    "slug": "nuts",
    "icon": "./assets/app-icon.png",
    "scheme": ["nutsrn", "nostr"],
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.nutsrn",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["nostrconnect"]
      }
    },
    "android": {
      "package": "com.nutsrn",
      "googleServicesFile": "./android/app/google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "nostr" }],
          "category": ["DEFAULT", "BROWSABLE"]
        },
        {
          "action": "VIEW",
          "data": [{ "scheme": "https", "host": "njump.me" }],
          "category": ["DEFAULT", "BROWSABLE"]
        },
        {
          "action": "VIEW",
          "data": [{ "scheme": "https", "host": "nuts.cash", "pathPrefix": "/redeem" }],
          "category": ["DEFAULT", "BROWSABLE"]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nuts to scan payment and profile QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nuts to choose a profile picture and attach images to posts."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Nuts to show recent photos and videos in the post composer.",
          "savePhotosPermission": "Allow Nuts to save media to your library."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Nuts to use Face ID before copying your private key."
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent",
          "ios": {
            "defaultLaunchURL": "http://192.168.178.132:8081/?platform=ios&dev=true&minify=false",
            "skipOnboarding": true
          },
          "android": {
            "defaultLaunchURL": "http://192.168.178.132:8081/?platform=android&dev=true&minify=false",
            "skipOnboarding": true
          }
        }
      ],
      "expo-notifications",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17130D",
          "image": "./assets/splash-icon-white.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#17130D",
            "image": "./assets/splash-icon-white.png"
          }
        }
      ],
      "expo-web-browser",
      "expo-router",
      "expo-status-bar"
    ]
  }
}
