{
  "expo": {
    "name": "Nuts Dev",
    "slug": "nuts-rn",
    "scheme": "nutsrn",
    "ios": {
      "bundleIdentifier": "com.nutsrn"
    },
    "android": {
      "package": "com.nutsrn"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NutsRn to scan payment and profile QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NutsRn to choose a profile picture and attach images to posts."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow NutsRn to show recent photos and videos in the post composer.",
          "savePhotosPermission": "Allow NutsRn to save media to your library."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow NutsRn to use Face ID before copying your private key."
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent",
          "ios": {
            "defaultLaunchURL": "http://192.168.178.132:8081/?platform=ios&dev=true&minify=false",
            "skipOnboarding": true
          },
          "android": {
            "defaultLaunchURL": "http://192.168.178.132:8081/?platform=android&dev=true&minify=false",
            "skipOnboarding": true
          }
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#131716",
          "image": "./assets/splash-nutscash.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#131716",
            "image": "./assets/splash-nutscash.png"
          }
        }
      ],
      "expo-web-browser"
    ]
  }
}
